import random

# -------------------------------------------------------------------------
# HELPER FUNCTIONS (The Rules of the Game)
# -------------------------------------------------------------------------

def deal_card():
    """Returns a random card from the deck."""
    # 11 represents the Ace. 10s represent Jack, Queen, King.
    cards = [11, 2, 3, 4, 5, 6, 7, 8, 9, 10, 10, 10, 10]
    return random.choice(cards)


def calculate_score(cards_list):
    """Takes a list of cards and returns the calculated integer score."""
    # Check for a Blackjack (Ace + 10-value card with exactly 2 cards)
    # We return 0 to represent a natural Blackjack in our game logic
    if sum(cards_list) == 21 and len(cards_list) == 2:
        return 0
    
    # If the score is over 21 but contains an Ace (11), convert the Ace to a 1
    if 11 in cards_list and sum(cards_list) > 21:
        cards_list.remove(11)
        cards_list.append(1)
        
    return sum(cards_list)


def compare(user_score, computer_score):
    """Compares the final scores to determine the win/loss outcome."""
    if user_score == computer_score:
        return "Draw 🙃"
    elif computer_score == 0:
        return "Lose, opponent has Blackjack 😱"
    elif user_score == 0:
        return "Win with a Blackjack 😎"
    elif user_score > 21:
        return "You went over. You lose 😭"
    elif computer_score > 21:
        return "Opponent went over. You win 😁"
    elif user_score > computer_score:
        return "You win 😃"
    else:
        return "You lose 😤"

# -------------------------------------------------------------------------
# MAIN GAME CORE ENGINE
# -------------------------------------------------------------------------

def play_game():
    """Runs a single complete game of Blackjack."""
    print("\n" * 20)  # Simple VS Code console clear trick
    print("--- Welcome to the Blackjack Capstone Project ---")
    
    user_cards = []
    computer_cards = []
    is_game_over = False

    # Deal initial 2 cards to both player and dealer
    for _ in range(2):
        user_cards.append(deal_card())
        computer_cards.append(deal_card())

    # 1. Player's Turn Loop
    while not is_game_over:
        user_score = calculate_score(user_cards)
        computer_score = calculate_score(computer_cards)
        
        print(f"   Your cards: {user_cards}, current score: {user_score}")
        print(f"   Computer's first card: {computer_cards[0]}")

        # Check if anyone hit Blackjack or went bust to end the turn early
        if user_score == 0 or computer_score == 0 or user_score > 21:
            is_game_over = True
        else:
            # Ask the user if they want to hit or stand
            user_should_deal = input("Type 'y' to get another card, type 'n' to pass: ").lower()
            if user_should_deal == 'y':
                user_cards.append(deal_card())
            else:
                is_game_over = True

    # 2. Computer's Turn Loop (Dealer strategy: Must hit if score is under 17 and not 0)
    while computer_score != 0 and computer_score < 17:
        computer_cards.append(deal_card())
        computer_score = calculate_score(computer_cards)

    # 3. Final Evaluation
    print("\n--- FINAL RESULTS ---")
    print(f"   Your final hand: {user_cards}, final score: {user_score}")
    print(f"   Computer's final hand: {computer_cards}, final score: {computer_score}")
    print(compare(user_score, computer_score))

# -------------------------------------------------------------------------
# GLOBAL RESTART TRIGGER
# -------------------------------------------------------------------------
while input("Do you want to play a game of Blackjack? Type 'y' or 'n': ").lower() == "y":
    play_game()
print("Goodbye!")